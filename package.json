{
  "name": "psystat",
  "version": "0.1.0",
  "description": "Logiciel d'analyse statistique pour la psychologie — Université Internationale de Rabat",
  "repository": "https://github.com/Siruuis/psystat",
  "license": "MIT",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "freeze": "node scripts/freeze-engine.mjs",
    "dist": "vite build && electron-builder",
    "dist:full": "npm run freeze && vite build && electron-builder"
  },
  "dependencies": {
    "docx": "^8.5.0",
    "pyodide": "^314.0.7",
    "xlsx": "0.18.5",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "concurrently": "8.2.2",
    "cross-env": "7.0.3",
    "electron": "32.0.1",
    "electron-builder": "24.13.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.5.4",
    "vite": "5.4.2",
    "wait-on": "8.0.0"
  },
  "build": {
    "appId": "org.psystat.app",
    "productName": "PsyStat",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "Siruuis",
      "repo": "psystat"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "engine/dist/psystat-engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "PsyStat-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PsyStat-Setup-${version}.exe"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
